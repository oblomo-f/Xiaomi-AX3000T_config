#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

stop_service() {
    # Ensure the watchdog process is really terminated.
    procd_kill 2>/dev/null || true
    sleep 1
    for pid in $(pgrep -f 'podkop-watchdog.sh' 2>/dev/null); do
        [ "$pid" = "$$" ] && continue
        kill "$pid" 2>/dev/null || true
    done
}

start_service() {
    [ "$(uci -q get podkop_watchdog.main.enabled)" = "1" ] || return 0

    procd_open_instance
    procd_set_param command /bin/sh -c 'sleep 10; exec /usr/libexec/podkop-watchdog.sh'
    procd_set_param respawn
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "podkop_watchdog"
}
