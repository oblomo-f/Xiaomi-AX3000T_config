#!/bin/sh

LOG="$(uci -q get podkop_watchdog.main.log || echo /root/podkop-watchdog.log)"

json_escape_file() {
	awk 'BEGIN { ORS="" }
	{
		gsub(/\\/, "\\\\");
		gsub(/"/, "\\\"");
		printf "%s\\n", $0
	}' "$1"
}

status_json() {
	if pgrep -f '/usr/libexec/podkop-watchdog.sh' >/dev/null 2>&1; then
		echo '{"running":true}'
	else
		echo '{"running":false}'
	fi
}

case "$1" in
	list)
		echo '{"status":{},"action":{"action":"String"},"log":{}}'
		;;

	call)
		case "$2" in
			status)
				status_json
				;;

			action)
				case "$3" in
					start)
						/etc/init.d/podkop-watchdog start
						;;
					stop)
						/etc/init.d/podkop-watchdog stop
						;;
					restart)
						/etc/init.d/podkop-watchdog restart
						;;
					check)
						if wget -q -T 10 -O /dev/null "https://$(uci -q get podkop_watchdog.main.domain || echo google.com)/"; then
							echo '{"ok":true}'
						else
							echo '{"ok":false}'
						fi
						;;
				esac
				;;

			log)
				if [ -r "$LOG" ]; then
					echo -n '{"text":"'
					json_escape_file "$LOG"
					echo '"}'
				else
					echo '{"text":""}'
				fi
				;;
		esac
		;;
esac
