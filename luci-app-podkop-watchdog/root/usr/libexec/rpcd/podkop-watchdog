#!/bin/sh

LOG="$(uci -q get podkop_watchdog.main.log || echo /root/podkop-watchdog.log)"

json_escape_file() {
	awk 'BEGIN { ORS="" }
	{
		gsub(/\\/, "\\\\");
		gsub(/"/, "\\\"");
		printf "%s\\n", $0
	}' "$1"
}

status_json() {
	ENABLED="$(uci -q get podkop_watchdog.main.enabled)"
	[ "$ENABLED" = "1" ] || ENABLED="0"

	# If the option is disabled, make sure the running service is stopped.
	if [ "$ENABLED" != "1" ]; then
		/etc/init.d/podkop-watchdog stop >/dev/null 2>&1 || true
	fi

	if pgrep -f 'podkop-watchdog.sh' >/dev/null 2>&1; then
		RUNNING="1"
	else
		RUNNING="0"
	fi

	if [ "$RUNNING" = "1" ]; then RUNNING_JSON=true; else RUNNING_JSON=false; fi
	if [ "$ENABLED" = "1" ]; then ENABLED_JSON=true; else ENABLED_JSON=false; fi
	printf '{"running":%s,"enabled":%s}\n' "$RUNNING_JSON" "$ENABLED_JSON"
}

get_action() {
	# rpcd passes ubus method arguments to the plugin via stdin as JSON.
	INPUT="$(cat)"
	[ -n "$INPUT" ] || return 0

	jsonfilter -s "$INPUT" -e '@.action' 2>/dev/null
}

case "$1" in
	list)
		echo '{"status":{},"action":{"action":"String"},"log":{}}'
		;;

	call)
		case "$2" in
			status)
				status_json
				;;

			action)
				ACTION="$(get_action)"
				case "$ACTION" in
					start)
						uci -q set podkop_watchdog.main.enabled='1'
						uci -q commit podkop_watchdog
						/etc/init.d/podkop-watchdog start >/dev/null 2>&1 || true
						echo '{"ok":true}'
						;;
					stop)
						/etc/init.d/podkop-watchdog stop >/dev/null 2>&1 || true
						sleep 1
						for pid in $(pgrep -f 'podkop-watchdog.sh' 2>/dev/null); do
							kill "$pid" 2>/dev/null || true
						done
						uci -q set podkop_watchdog.main.enabled='0'
						uci -q commit podkop_watchdog
						echo '{"ok":true}'
						;;
					restart)
						uci -q set podkop_watchdog.main.enabled='1'
						uci -q commit podkop_watchdog
						/etc/init.d/podkop-watchdog restart >/dev/null 2>&1 || true
						echo '{"ok":true}'
						;;
					commit)
						uci commit podkop_watchdog
						echo '{"ok":true}'
						;;
					reload_wan_podkop)
						WAN_INTERFACE="$(uci -q get podkop_watchdog.main.wan_interface 2>/dev/null)"
						[ -n "$WAN_INTERFACE" ] || WAN_INTERFACE="wan"
						IFDOWN="$(command -v ifdown 2>/dev/null || true)"
						IFUP="$(command -v ifup 2>/dev/null || true)"
						[ -n "$IFDOWN" ] || [ -x /sbin/ifdown ] && IFDOWN="/sbin/ifdown"
						[ -n "$IFUP" ] || [ -x /sbin/ifup ] && IFUP="/sbin/ifup"
						if [ -n "$IFDOWN" ] && [ -x "$IFDOWN" ]; then
							"$IFDOWN" "$WAN_INTERFACE" >/dev/null 2>&1 || true
						fi
						sleep 3
						if [ -n "$IFUP" ] && [ -x "$IFUP" ]; then
							"$IFUP" "$WAN_INTERFACE" >/dev/null 2>&1 || true
						fi
						sleep 5
						/etc/init.d/podkop restart >/dev/null 2>&1 || true
						echo '{"ok":true}'
						;;
					check)
						DOMAIN="$(uci -q get podkop_watchdog.main.domain)"
						[ -n "$DOMAIN" ] || DOMAIN="google.com"
						DOMAIN="$(printf '%s' "$DOMAIN" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

						if /usr/bin/wget -q -T 10 -O /dev/null "https://$DOMAIN/"; then
							echo '{"ok":true}'
						else
							echo '{"ok":false}'
						fi
						;;
					*)
						echo '{"ok":false,"error":"unknown action"}'
						;;
				esac
				;;

			log)
				if [ -r "$LOG" ]; then
					echo -n '{"text":"'
					json_escape_file "$LOG"
					echo '"}'
				else
					echo '{"text":""}'
				fi
				;;
		esac
		;;
esac
