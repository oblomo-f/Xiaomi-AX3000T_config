#!/bin/sh

LOG="$(uci -q get podkop_watchdog.main.log || echo /root/podkop-watchdog.log)"

json_escape_file() {
	awk 'BEGIN { ORS="" }
	{
		gsub(/\\/, "\\\\");
		gsub(/"/, "\\\"");
		printf "%s\\n", $0
	}' "$1"
}

status_json() {
	if pgrep -f '/usr/libexec/podkop-watchdog.sh' >/dev/null 2>&1; then
		echo '{"running":true}'
	else
		echo '{"running":false}'
	fi
}

case "$1" in
	list)
		echo '{"status":{},"action":{"action":"String"},"log":{}}'
		;;

	call)
		case "$2" in
			status)
				status_json
				;;

			action)
				ACTION="$(jsonfilter -s "$3" -e '@.action' 2>/dev/null)"
				case "$ACTION" in
					start)
						/etc/init.d/podkop-watchdog start >/dev/null 2>&1
						echo '{"ok":true}'
						;;
					stop)
						/etc/init.d/podkop-watchdog stop >/dev/null 2>&1
						echo '{"ok":true}'
						;;
					restart)
						/etc/init.d/podkop-watchdog restart >/dev/null 2>&1
						echo '{"ok":true}'
						;;
					commit)
						uci commit podkop_watchdog
						echo '{"ok":true}'
						;;
					check)
						DOMAIN="$(uci -q get podkop_watchdog.main.domain || echo google.com)"
						if wget -q -T 10 -O /dev/null "https://$DOMAIN/"; then
							echo '{"ok":true}'
						else
							echo '{"ok":false}'
						fi
						;;
					*)
						echo '{"ok":false,"error":"unknown action"}'
						;;
				esac
				;;

			log)
				if [ -r "$LOG" ]; then
					echo -n '{"text":"'
					json_escape_file "$LOG"
					echo '"}'
				else
					echo '{"text":""}'
				fi
				;;
		esac
		;;
esac
