{
	"luci-app-podkop-watchdog": {
		"description": "Manage Podkop Watchdog",
		"read": {
			"uci": [ "podkop_watchdog" ],
			"ubus": {
				"luci": [ "getFeatures" ],
				"rpcd": [ "list" ],
				"podkop-watchdog": [ "status", "action" ]
			},
			"file": [
				"/etc/config/podkop_watchdog",
				"/root/podkop-watchdog.log"
			]
		},
		"write": {
			"uci": [ "podkop_watchdog" ],
			"ubus": {
				"podkop-watchdog": [ "action" ]
			}
		}
	}
}
