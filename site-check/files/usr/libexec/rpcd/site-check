#!/bin/sh

json_escape()
{
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g; s/\r/\\r/g; s/\n/\\n/g'
}

port_in_use()
{
    PORT="$1"
    HEXPORT="$(printf '%04X' "$PORT")"
    grep -qi ":$HEXPORT " /proc/net/tcp /proc/net/tcp6 2>/dev/null
}

detect_route()
{
    URL="$1"

    BASE_PORT=$((45000 + ($$ % 10000)))
    PORT=""

    i=0
    while [ "$i" -lt 20 ]; do
        TEST_PORT=$((BASE_PORT + i))
        if ! port_in_use "$TEST_PORT"; then
            PORT="$TEST_PORT"
            break
        fi
        i=$((i + 1))
    done

    if [ -z "$PORT" ]; then
        echo "unknown"
        return 0
    fi

    TRACE_TABLE="site_check_trace_$$"
    TRACE_FILE="/tmp/site-check-trace.$$"
    REMOTE_IP_FILE="/tmp/site-check-route-ip.$$"

    if ! nft add table inet "$TRACE_TABLE" 2>/dev/null; then
        echo "unknown"
        return 0
    fi

    if ! nft "add chain inet $TRACE_TABLE output { type filter hook output priority -500; policy accept; }" 2>/dev/null; then
        nft delete table inet "$TRACE_TABLE" 2>/dev/null
        echo "unknown"
        return 0
    fi

    if ! nft add rule inet "$TRACE_TABLE" output tcp sport "$PORT" meta nftrace set 1 2>/dev/null; then
        nft delete table inet "$TRACE_TABLE" 2>/dev/null
        echo "unknown"
        return 0
    fi

    rm -f "$TRACE_FILE" "$REMOTE_IP_FILE"

    nft monitor trace > "$TRACE_FILE" 2>/dev/null &
    MONITOR_PID=$!

    sleep 1

    REMOTE_IP="$(
        /usr/bin/curl \
            -4 \
            -L \
            -sS \
            -o /dev/null \
            -w '%{remote_ip}' \
            --connect-timeout 10 \
            --max-time 20 \
            --local-port "$PORT" \
            "$URL" 2>/dev/null
    )"
    CURL_RET=$?

    printf '%s\n' "$REMOTE_IP" > "$REMOTE_IP_FILE"

    sleep 1

    kill "$MONITOR_PID" 2>/dev/null
    wait "$MONITOR_PID" 2>/dev/null

    nft delete table inet "$TRACE_TABLE" 2>/dev/null

    if [ "$CURL_RET" -eq 45 ]; then
        case "$REMOTE_IP" in
            198.18.*|198.19.*)
                rm -f "$TRACE_FILE" "$REMOTE_IP_FILE"
                echo "podkop"
                return 0
                ;;
        esac

        rm -f "$TRACE_FILE" "$REMOTE_IP_FILE"
        echo "unknown"
        return 0
    fi

    if [ ! -s "$TRACE_FILE" ]; then
        case "$REMOTE_IP" in
            198.18.*|198.19.*)
                rm -f "$TRACE_FILE" "$REMOTE_IP_FILE"
                echo "podkop"
                return 0
                ;;
        esac

        rm -f "$TRACE_FILE" "$REMOTE_IP_FILE"
        echo "direct"
        return 0
    fi

    ROUTE="$(awk '
    BEGIN {
        podkop = 0
        zapret = 0
    }

    {
        if ($0 ~ /inet PodkopTable/ &&
            ($0 ~ /meta mark set/ ||
             $0 ~ /tproxy ip to 127\.0\.0\.1:1602/)) {
            podkop = 1
        }

        if ($0 ~ /inet zapret/ &&
            $0 ~ /queue/) {
            zapret = 1
        }
    }

    END {
        if (podkop && zapret)
            print "podkop+zapret"
        else if (podkop)
            print "podkop"
        else if (zapret)
            print "zapret"
        else
            print "direct"
    }
    ' "$TRACE_FILE")"

    # Дополнительный признак Podkop:
    # 198.18.0.0/15 используется Podkop для TProxy.
    case "$REMOTE_IP" in
        198.18.*|198.19.*)
            ROUTE="podkop"
            ;;
    esac

    rm -f "$TRACE_FILE" "$REMOTE_IP_FILE"

    echo "${ROUTE:-unknown}"
    return 0
}

write_job()
{
    ID="$1"
    shift
    FILE="/tmp/site-check-job-$ID.json"
    TMP="${FILE}.tmp"

    printf '%s\n' "$*" > "$TMP"
    mv "$TMP" "$FILE"
}

run_job()
{
    ID="$1"
    URL="$2"
    DETECT_ROUTE="$3"

    JOB="/tmp/site-check-job-$ID.json"
    BODY="/tmp/site-check-body-$ID"
    OUT="/tmp/site-check-curl-$ID.out"
    ERR="/tmp/site-check-curl-$ID.err"

    rm -f "$BODY" "$OUT" "$ERR"

    # The network check itself is performed once by curl.
    /usr/bin/curl \
        -4 \
        -L \
        -sS \
        -o "$BODY" \
        -w '%{http_code}|%{time_total}|%{remote_ip}|%{url_effective}|%{size_download}|%{content_type}' \
        --connect-timeout 10 \
        --max-time 20 \
        "$URL" >"$OUT" 2>"$ERR" &
    CURL_PID=$!

    # Wait for curl to finish. The diagnostic lines below are then
    # deliberately published one by one so LuCI can display them separately.
    wait "$CURL_PID"
    CURL_RET=$?

    CURL_OUTPUT="$(cat "$OUT" 2>/dev/null)"
    HTTP_CODE="$(printf '%s' "$CURL_OUTPUT" | cut -d'|' -f1)"
    TIME_TOTAL="$(printf '%s' "$CURL_OUTPUT" | cut -d'|' -f2)"
    REMOTE_IP="$(printf '%s' "$CURL_OUTPUT" | cut -d'|' -f3)"
    URL_EFFECTIVE="$(printf '%s' "$CURL_OUTPUT" | cut -d'|' -f4)"
    SIZE_DOWNLOAD="$(printf '%s' "$CURL_OUTPUT" | cut -d'|' -f5)"
    CONTENT_TYPE="$(printf '%s' "$CURL_OUTPUT" | cut -d'|' -f6-)"
    CURL_ERR="$(cat "$ERR" 2>/dev/null)"

    DNS="ok"
    TCP="ok"
    TLS="ok"
    HTTP="ok"
    AVAILABLE=true

    case "$CURL_RET" in
        6)
            DNS="error"; TCP="pending"; TLS="pending"; HTTP="pending"; AVAILABLE=false ;;
        7|28)
            DNS="ok"; TCP="error"; TLS="pending"; HTTP="pending"; AVAILABLE=false ;;
        35|51|53|60|66|77)
            DNS="ok"; TCP="ok"; TLS="error"; HTTP="pending"; AVAILABLE=false ;;
        0)
            DNS="ok"; TCP="ok"; TLS="ok"; HTTP="ok" ;;
        *)
            DNS="ok"; TCP="ok"; TLS="ok"; HTTP="error"; AVAILABLE=false ;;
    esac

    if [ "$CURL_RET" -eq 0 ] || { [ -n "$HTTP_CODE" ] && [ "$HTTP_CODE" != "000" ]; }; then
        DNS="ok"
        TCP="ok"
        TLS="ok"
        HTTP="ok"
        AVAILABLE=true
    fi

    if [ -s "$BODY" ]; then
        CONTENT_OK=true
    else
        CONTENT_OK=false
    fi

    # Publish only the stages that were actually reached.
    if [ "$DNS" = "ok" ]; then
        write_job "$ID" '{"state":"running","dns":"ok","tcp":"pending","tls":"pending","http":"pending","route":"not_checked","final":false}'
        sleep 0.8
    else
        write_job "$ID" '{"state":"running","dns":"error","tcp":"pending","tls":"pending","http":"pending","route":"not_checked","final":false}'
        sleep 0.8
    fi

    if [ "$TCP" = "ok" ]; then
        write_job "$ID" '{"state":"running","dns":"ok","tcp":"ok","tls":"pending","http":"pending","route":"not_checked","final":false}'
        sleep 0.8
    elif [ "$TCP" = "error" ]; then
        write_job "$ID" '{"state":"running","dns":"ok","tcp":"error","tls":"pending","http":"pending","route":"not_checked","final":false}'
        sleep 0.8
        rm -f "$BODY" "$OUT" "$ERR"
        return 0
    fi

    if [ "$TLS" = "ok" ]; then
        write_job "$ID" '{"state":"running","dns":"ok","tcp":"ok","tls":"ok","http":"pending","route":"not_checked","final":false}'
        sleep 0.8
    elif [ "$TLS" = "error" ]; then
        write_job "$ID" '{"state":"running","dns":"ok","tcp":"ok","tls":"error","http":"pending","route":"not_checked","final":false}'
        sleep 0.8
        rm -f "$BODY" "$OUT" "$ERR"
        return 0
    fi

    if [ "$HTTP" = "ok" ]; then
        write_job "$ID" '{"state":"running","dns":"ok","tcp":"ok","tls":"ok","http":"ok","route":"not_checked","final":false}'
        sleep 0.8
    else
        write_job "$ID" '{"state":"running","dns":"ok","tcp":"ok","tls":"ok","http":"error","route":"not_checked","final":false}'
        sleep 0.8
        rm -f "$BODY" "$OUT" "$ERR"
        return 0
    fi

    ROUTE="not_checked"
    if [ "$DETECT_ROUTE" = "true" ] || [ "$DETECT_ROUTE" = "1" ]; then
        ROUTE="$(detect_route "$URL")"
    fi

    # Final result: route is shown immediately after HTTP, followed by
    # content and the remaining response information.
    printf '{"state":"done","final":true,"ok":true,"available":%s,"dns":"%s","tcp":"%s","tls":"%s","http":"%s","http_code":%s,"time":"%s","ip":"%s","url":"%s","size":"%s","content_type":"%s","content_ok":%s,"curl_code":%s,"route":"%s"}\n' \
        "$AVAILABLE" "$DNS" "$TCP" "$TLS" "$HTTP" \
        "${HTTP_CODE:-0}" \
        "$(json_escape "${TIME_TOTAL:-0}")" \
        "$(json_escape "${REMOTE_IP:-}")" \
        "$(json_escape "${URL_EFFECTIVE:-$URL}")" \
        "${SIZE_DOWNLOAD:-0}" \
        "$(json_escape "${CONTENT_TYPE:-}")" \
        "$CONTENT_OK" "$CURL_RET" \
        "$(json_escape "${ROUTE:-not_checked}")" > "${JOB}.tmp"

    mv "${JOB}.tmp" "$JOB"

    rm -f "$BODY" "$OUT" "$ERR"

    # Keep final JSON briefly for the last LuCI poll, then remove it.
    (
        sleep 10
        rm -f "$JOB"
    ) >/dev/null 2>&1 &
}

cleanup_old_jobs()
{
    NOW="$(date +%s)"

    for JOB in /tmp/site-check-job-*.json; do
        [ -f "$JOB" ] || continue

        MTIME="$(stat -c %Y "$JOB" 2>/dev/null)"
        [ -n "$MTIME" ] || continue

        AGE=$((NOW - MTIME))

        # Keep a finished result briefly so the last LuCI status request
        # can read it, then remove it.
        if [ "$AGE" -gt 10 ]; then
            rm -f "$JOB"
        fi
    done
}

start_check()
{
    URL="$1"
    DETECT_ROUTE="$2"

    if [ -z "$URL" ]; then
        echo '{"ok":false,"error":"URL не указан"}'
        return
    fi

    URL="$(printf '%s' "$URL" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

    case "$URL" in
        http://*|https://*) ;;
        *)
            echo '{"ok":false,"error":"URL должен начинаться с http:// или https://"}'
            return
            ;;
    esac

    cleanup_old_jobs

    ID="$$-$(date +%s)-$RANDOM"
    ID="$(printf '%s' "$ID" | tr -cd 'A-Za-z0-9_-')"

    JOB="/tmp/site-check-job-$ID.json"

    # Create the job immediately. This prevents the first LuCI status
    # request from seeing "Проверка не найдена".
    printf '%s\n' '{"state":"running","final":false,"ok":true,"available":false,"dns":"pending","tcp":"pending","tls":"pending","http":"pending","route":"not_checked"}' > "$JOB"

    run_job "$ID" "$URL" "$DETECT_ROUTE" >/dev/null 2>&1 &

    echo "{\"ok\":true,\"id\":\"$ID\"}"
}

status_check()
{
    ID="$1"

    case "$ID" in
        ''|*[!A-Za-z0-9_-]*)
            echo '{"ok":false,"error":"Неверный идентификатор проверки"}'
            return
            ;;
    esac

    JOB="/tmp/site-check-job-$ID.json"

    if [ ! -f "$JOB" ]; then
        echo '{"ok":false,"state":"error","error":"Проверка не найдена"}'
        return
    fi

    cat "$JOB"
}

package_version()
{
    PKG="$1"
    opkg list-installed 2>/dev/null | awk -v p="$PKG" '$1 == p { print $3; found=1; exit } END { if (!found) print "" }'
}

system_info()
{
    BOARD="$(ubus call system board 2>/dev/null)"

    MODEL="$(printf '%s' "$BOARD" | jsonfilter -e '@.model' 2>/dev/null)"
    DISTRIBUTION="$(printf '%s' "$BOARD" | jsonfilter -e '@.release.distribution' 2>/dev/null)"
    VERSION="$(printf '%s' "$BOARD" | jsonfilter -e '@.release.version' 2>/dev/null)"
    REVISION="$(printf '%s' "$BOARD" | jsonfilter -e '@.release.revision' 2>/dev/null)"
    DESCRIPTION="$(printf '%s' "$BOARD" | jsonfilter -e '@.release.description' 2>/dev/null)"

    OS="$DESCRIPTION"
    if [ -z "$OS" ]; then
        OS="$DISTRIBUTION"
        [ -n "$VERSION" ] && OS="$OS $VERSION"
        [ -n "$REVISION" ] && OS="$OS $REVISION"
    fi

    PODKOP="$(package_version podkop)"
    ZAPRET="$(package_version zapret)"
    ZAPRET2="$(package_version zapret2)"
    ZEROBLOCK="$(package_version zeroblock)"

    printf '{"ok":true,"packages":{"podkop":"%s","zapret":"%s","zapret2":"%s","zeroblock":"%s"},"model":"%s","os":"%s"}\n' \
        "$(json_escape "$PODKOP")" \
        "$(json_escape "$ZAPRET")" \
        "$(json_escape "$ZAPRET2")" \
        "$(json_escape "$ZEROBLOCK")" \
        "$(json_escape "$MODEL")" \
        "$(json_escape "$OS")"
}



check_url()
{
    URL="$1"
    DETECT_ROUTE="$2"

    if [ -z "$URL" ]; then
        echo '{"ok":false,"error":"URL не указан"}'
        return
    fi

    URL="$(printf '%s' "$URL" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"

    case "$URL" in
        http://*|https://*) ;;
        *)
            echo '{"ok":false,"error":"URL должен начинаться с http:// или https://"}'
            return
            ;;
    esac

    BODY_FILE="/tmp/site-check-body.$$"
    CURL_ERR_FILE="/tmp/site-check-curl.$$"
    rm -f "$BODY_FILE" "$CURL_ERR_FILE"

    CURL_OUTPUT="$(
        /usr/bin/curl \
            -4 \
            -L \
            -sS \
            -o "$BODY_FILE" \
            -w '%{http_code}|%{time_total}|%{remote_ip}|%{url_effective}|%{size_download}|%{content_type}' \
            --connect-timeout 10 \
            --max-time 20 \
            "$URL" 2>"$CURL_ERR_FILE"
    )"
    CURL_RET=$?

    HTTP_CODE="$(printf '%s' "$CURL_OUTPUT" | cut -d'|' -f1)"
    TIME_TOTAL="$(printf '%s' "$CURL_OUTPUT" | cut -d'|' -f2)"
    REMOTE_IP="$(printf '%s' "$CURL_OUTPUT" | cut -d'|' -f3)"
    URL_EFFECTIVE="$(printf '%s' "$CURL_OUTPUT" | cut -d'|' -f4)"
    SIZE_DOWNLOAD="$(printf '%s' "$CURL_OUTPUT" | cut -d'|' -f5)"
    CONTENT_TYPE="$(printf '%s' "$CURL_OUTPUT" | cut -d'|' -f6-)"

    DNS="ok"
    TCP="ok"
    TLS="ok"
    HTTP="ok"
    AVAILABLE=true

    case "$CURL_RET" in
        6)
            DNS="error"; TCP="error"; TLS="error"; HTTP="error"; AVAILABLE=false ;;
        7|28)
            TCP="error"; TLS="error"; HTTP="error"; AVAILABLE=false ;;
        35|51|53|60|66|77)
            TLS="error"; HTTP="error"; AVAILABLE=false ;;
        0) ;;
        *)
            HTTP="error"; AVAILABLE=false ;;
    esac

    if [ -n "$HTTP_CODE" ] && [ "$HTTP_CODE" != "000" ]; then
        HTTP="ok"
        AVAILABLE=true
    fi

    if [ -s "$BODY_FILE" ]; then
        CONTENT_OK=true
    else
        CONTENT_OK=false
    fi

    if [ "$DETECT_ROUTE" = "true" ] || [ "$DETECT_ROUTE" = "1" ]; then
        ROUTE="$(detect_route "$URL")"
    else
        ROUTE="not_checked"
    fi

    REDIRECT="false"
    REDIRECT_URL=""
    REDIRECT_ROUTE="not_checked"
    REDIRECT_MORE="false"

    REDIRECT_HEADERS="$(
        /usr/bin/curl \
            -4 \
            -sS \
            -D - \
            -o /dev/null \
            --connect-timeout 3 \
            --max-time 3 \
            "$URL" 2>/dev/null
    )"

    REDIRECT_RET=$?

    if [ "$REDIRECT_RET" -eq 0 ]; then

        REDIRECT_CODE="$(
            printf '%s\n' "$REDIRECT_HEADERS" |
            sed -n 's#^HTTP/[^ ]*[[:space:]]\+\([0-9][0-9][0-9]\).*#\1#p' |
            tail -n 1
        )"

        case "$REDIRECT_CODE" in
            301|302|303|307|308)

                LOCATION="$(
                    printf '%s\n' "$REDIRECT_HEADERS" |
                    sed -n 's/^[Ll]ocation:[[:space:]]*//p' |
                    tail -n 1 |
                    tr -d '\r'
                )"

                if [ -n "$LOCATION" ]; then
                    REDIRECT="true"

                    case "$LOCATION" in
                        http://*|https://*)
                            REDIRECT_URL="$LOCATION"
                            ;;
                        /*)
                            BASE="$(
                                printf '%s\n' "$URL" |
                                sed -E 's#^(https?://[^/]+).*#\1#'
                            )"
                            REDIRECT_URL="${BASE}${LOCATION}"
                            ;;
                        *)
                            BASE="$(
                                printf '%s\n' "$URL" |
                                sed -E 's#^(https?://.*/)[^/]*$#\1#'
                            )"
                            REDIRECT_URL="${BASE}${LOCATION}"
                            ;;
                    esac

                    if [ "$DETECT_ROUTE" = "true" ] || [ "$DETECT_ROUTE" = "1" ]; then
                        REDIRECT_ROUTE="$(detect_route "$REDIRECT_URL")"
                    fi

                    SECOND_HEADERS="$(
                        /usr/bin/curl \
                            -4 \
                            -sS \
                            -D - \
                            -o /dev/null \
                            --connect-timeout 3 \
                            --max-time 3 \
                            "$REDIRECT_URL" 2>/dev/null
                    )"

                    SECOND_RET=$?

                    if [ "$SECOND_RET" -eq 0 ]; then
                        SECOND_CODE="$(
                            printf '%s\n' "$SECOND_HEADERS" |
                            sed -n 's#^HTTP/[^ ]*[[:space:]]\+\([0-9][0-9][0-9]\).*#\1#p' |
                            tail -n 1
                        )"

                        case "$SECOND_CODE" in
                            301|302|303|307|308)
                                SECOND_LOCATION="$(
                                    printf '%s\n' "$SECOND_HEADERS" |
                                    sed -n 's/^[Ll]ocation:[[:space:]]*//p' |
                                    tail -n 1 |
                                    tr -d '\r'
                                )"

                                [ -n "$SECOND_LOCATION" ] && REDIRECT_MORE="true"
                                ;;
                        esac
                    fi
                fi
                ;;
        esac
    fi

    rm -f "$BODY_FILE" "$CURL_ERR_FILE"

    printf '{"ok":true,"available":%s,"dns":"%s","tcp":"%s","tls":"%s","http":"%s","http_code":%s,"time":"%s","ip":"%s","url":"%s","size":"%s","content_type":"%s","content_ok":%s,"curl_code":%s,"route":"%s","redirect":%s,"redirect_url":"%s","redirect_route":"%s","redirect_more":%s}\n' \
        "$AVAILABLE" "$DNS" "$TCP" "$TLS" "$HTTP" \
        "${HTTP_CODE:-0}" \
        "$(json_escape "${TIME_TOTAL:-0}")" \
        "$(json_escape "${REMOTE_IP:-}")" \
        "$(json_escape "${URL_EFFECTIVE:-$URL}")" \
        "${SIZE_DOWNLOAD:-0}" \
        "$(json_escape "${CONTENT_TYPE:-}")" \
        "$CONTENT_OK" "$CURL_RET" \
        "$(json_escape "${ROUTE:-not_checked}")" \
        "$REDIRECT" \
        "$(json_escape "${REDIRECT_URL:-}")" \
        "$(json_escape "${REDIRECT_ROUTE:-not_checked}")" \
        "$REDIRECT_MORE"
}
case "$1" in
    list)
        echo '{"start":{"url":"String","route":"Boolean"},"status":{"id":"String"},"check":{"url":"String","route":"Boolean"},"system_info":{}}'
        ;;
    call)
        case "$2" in
            start)
                INPUT="$(cat)"
                URL="$(printf '%s' "$INPUT" | jsonfilter -e '@.url' 2>/dev/null)"
                DETECT_ROUTE="$(printf '%s' "$INPUT" | jsonfilter -e '@.route' 2>/dev/null)"
                start_check "$URL" "$DETECT_ROUTE"
                ;;
            status)
                INPUT="$(cat)"
                ID="$(printf '%s' "$INPUT" | jsonfilter -e '@.id' 2>/dev/null)"
                status_check "$ID"
                ;;
            system_info)
                system_info
                ;;
            check)
                INPUT="$(cat)"
                URL="$(printf '%s' "$INPUT" | jsonfilter -e '@.url' 2>/dev/null)"
                DETECT_ROUTE="$(printf '%s' "$INPUT" | jsonfilter -e '@.route' 2>/dev/null)"
                check_url "$URL" "$DETECT_ROUTE"
                ;;
            *)
                echo '{"error":"Метод не найден"}'
                ;;
        esac
        ;;
    *)
        echo '{"error":"Неизвестный вызов"}'
        ;;
esac
